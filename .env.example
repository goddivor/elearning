# Configuration du serveur backend
VITE_API_BASE_URL=http://localhost:3001
VITE_SERVER_URL=http://localhost:3001

# Google OAuth & Google One Tap
# Créer une application sur https://console.cloud.google.com
# 1. Créer des identifiants OAuth 2.0
# 2. Ajouter http://localhost:5173 dans les origines JavaScript autorisées
# 3. Pour Google One Tap, le même client ID est utilisé
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook OAuth
# Créer une application sur https://developers.facebook.com
# 1. Créer une nouvelle application
# 2. Ajouter le produit "Connexion Facebook"
# 3. Ajouter http://localhost:5173 dans les domaines d'application valides
VITE_FACEBOOK_APP_ID=your-facebook-app-id
